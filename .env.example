# Threads (Meta) API
THREADS_ACCESS_TOKEN=your_long_lived_access_token
PROACTIVE_PERMISSION_PROBE=false
PROACTIVE_ENABLED=false
PROACTIVE_MODE=OFF
PROACTIVE_ACCOUNT=ru
PROACTIVE_POLL_INTERVAL_SECONDS=14400
PROACTIVE_APPROVAL_POLL_SECONDS=60
PROACTIVE_DAILY_EVALUATION_LIMIT=150
PROACTIVE_DAILY_DRAFT_LIMIT=10
PROACTIVE_DAILY_AI_TOKEN_LIMIT=50000
PROACTIVE_MONTHLY_AI_COST_MICROUSD_LIMIT=1000000
PROACTIVE_APPROVAL_BASE_URL=https://your-telegram-service.example.com
PROACTIVE_APPROVAL_SECRET=generate_at_least_32_random_characters
PROACTIVE_OPENAI_MODEL=gpt-5.6-luna
THREADS_USER_ID=your_threads_user_id
THREADS_USERNAME=leoakastel
THREADS_VERIFY_TOKEN=any_random_string_you_pick_for_webhook_handshake
# Official Threads polling fallback for a tester/owned account when app-level webhooks cannot be used yet.
# Reads recent owned posts and their flattened conversations via the official Threads API.
# Keep BOT_DRY_RUN=true until a controlled end-to-end test is confirmed.
THREADS_POLLING_ENABLED=false
THREADS_POLLING_INTERVAL_MS=60000
THREADS_POLLING_POSTS_LIMIT=10
THREADS_POLLING_REPLIES_LIMIT=50

# Instagram API auth mode: instagram_login or facebook_login.
# facebook_login uses graph.facebook.com, resolves the linked Facebook Page in memory,
# and derives its Page Access Token from INSTAGRAM_ACCESS_TOKEN (a Facebook User Access Token).
INSTAGRAM_AUTH_MODE=instagram_login
INSTAGRAM_ENABLED=false
INSTAGRAM_DRY_RUN=true
INSTAGRAM_USER_ID=your_instagram_professional_user_id
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_ACCESS_TOKEN=your_instagram_or_facebook_user_access_token
INSTAGRAM_VERIFY_TOKEN=any_random_string_you_pick_for_webhook_handshake
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Official-API polling fallback for owned/managed accounts when real-time webhooks are unavailable.
# Reads recent media + comment edges only; replies remain governed by INSTAGRAM_DRY_RUN.
INSTAGRAM_POLLING_ENABLED=false
INSTAGRAM_POLLING_INTERVAL_MS=60000
INSTAGRAM_POLLING_MEDIA_LIMIT=10
INSTAGRAM_POLLING_COMMENTS_LIMIT=50
INSTAGRAM_POLLING_FULL_SCAN_EVERY=10

# Analytics Engine (read-only; Threads first)
ANALYTICS_ENGINE_ENABLED=false
ANALYTICS_INTERVAL_MS=21600000
ANALYTICS_MAX_POSTS_PER_ACCOUNT=25
ANALYTICS_LOOKBACK_DAYS=30
# Read-only export consumed by standalone Astel Hyper Crew / Edie.
# Leave empty to keep the route unmounted.
ANALYTICS_API_TOKEN=
ANALYTICS_EXPORT_PROJECT_ID=astel-business

# Content Pipeline / shared async AI (disabled by default)
CONTENT_PIPELINE_ENABLED=false
CONTENT_ALLOW_LIVE_SCHEDULING=false
CONTENT_AI_REDIS_NAMESPACE=astel:content-ai:v1
CONTENT_AI_DAILY_TOKEN_LIMIT=50000
CONTENT_AI_MONTHLY_COST_MICROUSD_LIMIT=1000000
CONTENT_AI_MAX_INPUT_TOKENS=20000
CONTENT_AI_MAX_OUTPUT_TOKENS=2000
AI_MODEL_CHEAP=gpt-5.6-luna
AI_MODEL_STANDARD=gpt-5.6-luna
AI_MODEL_REASONING=gpt-5.6-luna
# Explicit pricing is required before CONTENT_PIPELINE_ENABLED=true.
OPENAI_INPUT_USD_PER_1M=
OPENAI_CACHED_INPUT_USD_PER_1M=
OPENAI_OUTPUT_USD_PER_1M=

# Hyper Crew Orchestrator. Requires ready Content Runtime and stops at human approval.
HYPER_CREW_ENABLED=false

# Private content control API. Requires CONTENT_PIPELINE_ENABLED=true as well.
CONTENT_CONTROL_API_ENABLED=false
CONTENT_CONTROL_API_TOKEN=generate_at_least_32_random_characters
CONTENT_CONTROL_REDIS_NAMESPACE=astel:content-control:v1
CONTENT_CONTROL_IDEMPOTENCY_TTL_SECONDS=86400

# Airtable
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_base_id

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000

# Vision v9.2 (safe defaults)
VISION_ENABLED=false
VISION_DETAIL=low
VISION_SHORT_TEXT_THRESHOLD=24
VISION_METADATA_TIMEOUT_MS=12000

# Proactive Copilot discovery (read-only milestone; disabled by default)
PROACTIVE_ENABLED=false
PROACTIVE_MODE=OFF
PROACTIVE_POLL_INTERVAL_SECONDS=900
PROACTIVE_CANDIDATE_TTL_HOURS=72
PROACTIVE_MAX_POST_AGE_MINUTES=720
PROACTIVE_DEFAULT_LIMIT=25
PROACTIVE_REDIS_NAMESPACE=astel:proactive:v1

# Redis safety state
REDIS_URL=redis://redis.internal:6379
REDIS_REQUIRED=true

# PostgreSQL durable state
DATABASE_URL=postgresql://user:password@host:5432/db
DATABASE_REQUIRED=true
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000

# v9.1 policy
NORMAL_REPLY_LIMIT=3
COOLDOWN_SECONDS=20
CONVERSATION_RESET_HOURS=24
GLOBAL_DAILY_LIMIT=50
CLOSING_ENABLED=true
CLOSING_AT_REPLY=3
PARENT_LOOKUP_ENABLED=true

# Runtime
BOT_ENABLED=false
BOT_DRY_RUN=true
PORT=3000
# YouTube Community V1, ASAP GTA6 only. Gate 1–3 build: live transport hard disabled.
YOUTUBE_ENABLED=false
YOUTUBE_DRY_RUN=true
YOUTUBE_CHANNEL_ID=
YOUTUBE_USERNAME=ASAP GTA6
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REPLY_MODE=DRAFT_ONLY
YOUTUBE_POLLING_ENABLED=false
YOUTUBE_POLLING_INTERVAL_MS=60000
YOUTUBE_POLLING_MAX_RESULTS=100
YOUTUBE_FULL_SCAN_EVERY=10
YOUTUBE_LIVE_REPLY_DAILY_CAP=20
YOUTUBE_DAILY_QUOTA_BUDGET=9000
